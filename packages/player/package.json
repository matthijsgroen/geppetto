{
  "name": "geppetto-player",
  "version": "1.3.3",
  "description": "WebGL Player for Geppetto files",
  "keywords": [
    "canvas",
    "webgl",
    "2d",
    "animation",
    "interaction"
  ],
  "main": "dist/index.js",
  "source": "src/index.ts",
  "types": "dist/index.d.ts",
  "repository": "git@github.com:matthijsgroen/geppetto-player.git",
  "author": "Matthijs Groen <matthijs.groen@gmail.com> (https://github.com/matthijsgroen)",
  "homepage": "https://geppetto.js.org",
  "license": "MIT",
  "scripts": {
    "build-shaders": "bin/minifyShader.ts src/shaders/fragmentShader.frag && bin/minifyShader.ts src/shaders/vertexShader.vert",
    "build": "yarn build-shaders && parcel build",
    "postbuild": "yarn build-docs",
    "build-docs": "typedoc src/index.ts --includeVersion --name 'Geppetto Player' --json typedocs.json --logLevel Error",
    "postbuild-docs": "size-limit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10KB"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@parcel/packager-ts": "2.16.0",
    "@parcel/transformer-glsl": "2.16.0",
    "@parcel/transformer-typescript-types": "2.16.0",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@types/node": "24.9.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.0",
    "parcel": "^2.16.0",
    "prettier": "^3.7.1",
    "size-limit": "^12.0.0",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^2.1.8",
    "webpack-glsl-minify": "^1.4.2"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@geppetto/types": "workspace:*",
    "delaunator": "^4.0.1"
  },
  "browserslist": [
    "chrome 87",
    "firefox 78"
  ]
}
