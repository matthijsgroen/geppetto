{
  "name": "@geppetto/studio",
  "productName": "Geppetto",
  "version": "2.0.0-alpha.0",
  "type": "module",
  "description": "Geppetto is a free and open animation tool to embed webGL animations in a web site.",
  "author": "Matthijs Groen <matthijs.groen@gmail.com> (https://github.com/matthijsgroen)",
  "contributors": [
    "Guido Theelen <guidotheelen@gmail.com> (https://github.com/guidotheelen)"
  ],
  "private": true,
  "homepage": "./",
  "dependencies": {
    "@szhsin/react-menu": "^4.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "delaunator": "^5.0.1",
    "geppetto-player": "workspace:*",
    "immer": "^11.0.1",
    "react": "^19.2.1",
    "react-complex-tree": "1.1.8",
    "react-dom": "^19.2.1",
    "react-draggable": "^4.4.5",
    "typescript": "^5.9.3",
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "set-version": "bin/writeVersion.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --project=unit",
    "test:ui": "vitest --ui --project=unit",
    "test:run": "vitest run --project=unit",
    "test:coverage": "vitest run --coverage --project=unit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project=storybook"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-docs": "10.1.6",
    "@storybook/addon-themes": "10.1.5",
    "@storybook/addon-vitest": "10.1.5",
    "@storybook/react-vite": "10.1.5",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27",
    "@types/node": "^24.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "^4.0.16",
    "concurrently": "^7.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^27.3.0",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass-embedded": "^1.96.0",
    "storybook": "10.1.5",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.2.7",
    "vite-plugin-glsl": "^1.5.5",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^4.0.16",
    "wait-on": "^6.0.1",
    "workbox-window": "^7.4.0"
  },
  "packageManager": "yarn@4.12.0"
}
