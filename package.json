{
  "name": "geppetto-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "studio-dev": "turbo run dev --filter=@geppetto/studio",
    "storybook": "turbo run storybook --filter=@geppetto/studio",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "types:check": "turbo run types:check"
  },
  "devDependencies": {
    "turbo": "^2.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
